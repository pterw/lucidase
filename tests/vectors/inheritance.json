            "omim": null
          }
        },
        "CFTR": {
          "inheritance": {
            "model": "autosomal_recessive",
            "mendelian_disease": true,
            "penetrance": 1.0,
            "disease": "x",
            "omim": null
          }
        },
        "MTHFR": {
          "inheritance": {
            "model": "trait",
            "mendelian_disease": false,
            "penetrance": null,
            "disease": "x",
            "omim": null
          }
        }
      },
      "records": [
        {
          "rsid": "rs6025",
          "gene": "F5",
          "chrom": "1",
          "altCount": 1,
          "genotype_display": "C/T",
          "standalone": true,
          "role": "standard"
        },
        {
          "rsid": "rs1799963",
          "gene": "F2",
          "chrom": "11",
          "altCount": 1,
          "genotype_display": "G/A",
          "standalone": true,
          "role": "standard"
        }
      ]
    },
    "expected": {
      "findings": [
        {
          "genes": [
            "F5",
            "F2"
          ],
          "joint_transmission_prob": 0.25,
          "assumption": "assumes unlinked loci and a partner without these alleles"
        }
      ],
      "text_excludes": [
        "synergistic",
        "20-40",
        "thrombophilia"
      ]
    }
