[
  {
    "id": "ar-het-x-unscreened",
    "description": "AR carrier x unscreened partner with allele frequency q=0.02: child gets alt from the patient with 1/2 and from the partner with q",
    "input": {
      "fn": "scenario",
      "gene": {
        "inheritance": {
          "model": "autosomal_recessive",
          "mendelian_disease": true,
          "penetrance": 1.0,
          "disease": "x",
          "omim": null
        }
      },
      "altCount": 1,
      "partner": "unscreened",
      "af": 0.02,
      "allele": "F508del"
    },
    "expected": {
      "dist": {
        "available": true,
        "p0": 0.49,
        "p1": 0.5,
        "p2": 0.01
      },
      "outcome": {
        "kind": "mendelian",
        "affected": 0.01,
        "carrier": 0.5
      }
    }
  },
